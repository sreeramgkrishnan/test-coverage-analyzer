# MongoDB connection string (replace with real secret in CI/secret store)
MONGODB_URI=REPLACE_WITH_MONGODB_URI
MONGODB_DB_NAME=<YOUR_MONGODB_DB_NAME>
MONGODB_COLLECTION=<YOUR_COLLECTION_NAME>
MONGODB_VECTOR_INDEX=<YOUR_VECTOR_INDEX_NAME>
MONGODB_BM25_INDEX=<YOUR_BM25_INDEX_NAME>

# App settings
PORT=3000
NODE_ENV=development

# Embedding / LLM provider keys (replace)
MISTRAL_API_KEY=REPLACE_WITH_MISTRAL_API_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY

# GROQ LLM model
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Defaults
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Request size limits (bytes)
MAX_REQUEST_BODY_BYTES=1048576